# API Configuration
# Untuk development via Vite proxy, variabel ini tidak perlu diisi.
# Jika frontend mengakses backend secara langsung, URL harus menyertakan /api.
# VITE_API_URL=http://localhost:3000/api

# App Configuration
VITE_APP_NAME=WargaNet
VITE_APP_VERSION=1.0.0

# Environment
VITE_NODE_ENV=development
