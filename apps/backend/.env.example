# Runtime
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL — sama dengan docker-compose.yml
DATABASE_URL="postgresql://warganet:warganet_password@127.0.0.1:5432/warganet_db?schema=public"

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Better Auth
# Buat nilai lokal dengan: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000

# OTP WhatsApp — Fonnte Device Token
FONNTE_TOKEN=
WHATSAPP_MAX_RETRIES=3
WHATSAPP_RETRY_DELAY_MS=1000

# Midtrans. Gunakan key SB-Mid-* dan false untuk lokal.
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_MERCHANT_ID=

# JWT. Path relatif terhadap apps/backend (cwd backend).
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d

# OTP/rate limiting
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_OTP_PER_PHONE=3
RATE_LIMIT_OTP_PER_IP=10
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_OTP_VERIFICATION_MAX=5
IP_BLOCK_DURATION_HOURS=1

# File/PDF
ASSETS_PATH=./assets
PUPPETEER_EXECUTABLE_PATH=
PUPPETEER_ARGS=--no-sandbox,--disable-setuid-sandbox
PUPPETEER_TIMEOUT=30000
PDF_GENERATION_TIMEOUT=60000
PDF_MAX_CONCURRENT=3

# Operational
LOG_LEVEL=info
AUDIT_LOG_RETENTION_DAYS=365
SESSION_TIMEOUT_MINUTES=15
