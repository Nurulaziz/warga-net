# ============================================
# WargaNet Environment Variables
# ============================================

# ============================================
# Backend Configuration
# ============================================
NODE_ENV=development
PORT=3000

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
DATABASE_URL="postgresql://warganet:warganet_password@localhost:5432/warganet_db?schema=public"

# ============================================
# Redis Configuration
# ============================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================
# JWT Configuration
# ============================================
# Generate RSA keys using: openssl genrsa -out private.pem 2048
# Extract public key: openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY_PATH=./keys/private.pem
JWT_PUBLIC_KEY_PATH=./keys/public.pem
JWT_ACCESS_TOKEN_EXPIRY=15m
JWT_REFRESH_TOKEN_EXPIRY=30d

# ============================================
# OTP Configuration
# ============================================
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
BCRYPT_SALT_ROUNDS=10

# ============================================
# Rate Limiting Configuration
# ============================================
RATE_LIMIT_OTP_PER_PHONE=3
RATE_LIMIT_OTP_PER_IP=10
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_OTP_VERIFICATION_MAX=5
IP_BLOCK_DURATION_HOURS=1

# ============================================
# WhatsApp Gateway Configuration
# ============================================
# Choose your WhatsApp Gateway provider
WHATSAPP_GATEWAY_URL=https://api.whatsapp.example.com
WHATSAPP_API_KEY=your_whatsapp_api_key_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
WHATSAPP_MAX_RETRIES=3
WHATSAPP_RETRY_DELAY_MS=1000

# ============================================
# Frontend Configuration
# ============================================
FRONTEND_URL=http://localhost:5173

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGIN=http://localhost:5173
CORS_CREDENTIALS=true

# ============================================
# Monitoring & Logging
# ============================================
LOG_LEVEL=info
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# ============================================
# Audit & Security
# ============================================
AUDIT_LOG_RETENTION_DAYS=365
SESSION_TIMEOUT_MINUTES=15

# ============================================
# Backup Configuration
# ============================================
BACKUP_RETENTION_DAYS=30
BACKUP_ENCRYPTION_KEY=your_backup_encryption_key_here

# ============================================
# Email Configuration (Optional)
# ============================================
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@warganet.example.com
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=WargaNet <noreply@warganet.example.com>

# ============================================
# Frontend Environment Variables
# ============================================
# Create apps/frontend/.env.local with:
# VITE_API_URL=http://localhost:3000
